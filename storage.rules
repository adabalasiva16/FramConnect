rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{farmerId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /profilePictures/farmers/{farmerId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /profilePictures/customers/{customerId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
